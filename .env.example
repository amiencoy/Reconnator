# ==================================================================================== #
# This example declares Telegram access and provider-agnostic AI runtime settings.    #
# Copy it to .env and replace placeholders without committing real credentials.       #
# ==================================================================================== #

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_CHAT_IDS=your_numeric_chat_id_here

# AI provider: ollama | vllm | lmstudio | llamacpp | gemini | openai-compatible
# Ollama is the default and does not require an API key.
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
AI_BASE_URL=http://localhost:11434/v1/chat/completions
AI_API_KEY=
AI_TEMPERATURE=0
AI_TIMEOUT_SECONDS=300

# Optional automatic cloud fallback. If this key is set, Gemini is tried only when
# the selected local/OpenAI-compatible provider cannot complete the request.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
