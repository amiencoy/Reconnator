# =========================================================================================================================== #
# Reconnator Environment Variables Configuration.                                                                             #
# Rename this file to '.env' and populate it with your actual credentials.                                                    #
# CRITICAL: NEVER commit your actual .env file to version control. Keep it secret.                                            #
# Note: Cave-Sec is hardwired to use Gemini, so other LLM providers are not needed.                                           #
# If you are willing to use other models, add your own API key(s) here and erase the Gemini API, or else just leave it blank. #
# =========================================================================================================================== #

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here